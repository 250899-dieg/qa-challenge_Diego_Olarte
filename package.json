{
  "name": "skyline-skyways",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:api": "playwright test tests/api",
    "prepare": "husky install || true",
    "build:bdd": "tsc -p tsconfig.bdd.json",
    "test:bdd": "npm run build:bdd && cucumber-js && node expand-cucumber-report.js && node -e \"require('open')('test-results/cucumber-report.html')\"",
    "test:tag": "npm run build:bdd && cross-env TAGS=%npm_config_tags% cucumber-js && node expand-cucumber-report.js && node -e \"import('open').then(o => o.default('test-results/cucumber-report.html'))\""

  },
  "dependencies": {
    "clsx": "^2.1.0",
    "lucide-react": "^0.460.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.11.25",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.5",
    "open": "^11.0.0",
    "open-cli": "^8.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
